# ランドリー連絡AIアシスタント — 環境変数の見本
# 本番では Vercel の［Settings］→［Environment Variables］に登録します（このファイルに本物の値は書かないでください）。
# 何も設定しなくても、デモ版（LINEシミュレーター＋サンプルAI）として動きます。
# 詳しい手順は docs/PRODUCTION.md をご覧ください。

# ── LINE（2つそろうと本物のLINEとつながります）────────────────
# LINE Developers ›［チャネル基本設定］› チャネルシークレット
LINE_CHANNEL_SECRET=
# LINE Developers ›［Messaging API設定］› チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# ── LINEグループのID（Cから始まる33文字。ボットをグループに招待すると表示されます）──
# 清掃スタッフ用グループ
LINE_GROUP_CLEANING=
# コールセンター用グループ
LINE_GROUP_CALLCENTER=
# 管理者への通知（緊急・要対応）を送るグループ
LINE_GROUP_ALERTS=

# 任意：通知カードの「詳細を確認する」ボタンのリンク先（https のみ）
LINE_ALERT_LINK_URL=

# ── AI（設定するとサンプルAIから本物のAIに切り替わります）────────
# Claude（Anthropic）の APIキー
ANTHROPIC_API_KEY=
# 任意：使うモデル。通常は空欄のまま（claude-opus-5-5 を使います）
ANTHROPIC_MODEL=

# 任意：/api/analyze（判定テスト用API）の合言葉。
# 本番AI・LINEの接続情報・APP_SETTINGS_JSON のどれかを設定したら、これを設定しない限り
# /api/analyze は使えません（料金の不正利用と、返信文・スタッフ名などの設定の流出を防ぎます）。
ANALYZE_API_TOKEN=

# ── 返信文・判定ルールなどの設定 ────────────────────────────
# 任意：管理画面の［設定］→［データ］で書き出したJSONを1行で貼り付けます。
# 空欄なら初期設定を使います。
APP_SETTINGS_JSON=
